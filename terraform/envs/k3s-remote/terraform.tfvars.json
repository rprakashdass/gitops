{
    "kube_context": "k3s-remote",
    "kubeconfig_path": "~/.kube/config",
    "domain": "argocd.local",
    "ingress_enabled": true,
    "ingress_class_name": "traefik",
    "resources": {
        "controller": {
            "requests": {
                "cpu": "500m",
                "memory": "512Mi"
            },
            "limits": {
                "cpu": "1000m",
                "memory": "1Gi"
            }
        },
        "repoServer": {
            "requests": {
                "cpu": "500m",
                "memory": "512Mi"
            },
            "limits": {
                "cpu": "1000m",
                "memory": "1Gi"
            }
        },
        "server": {
            "requests": {
                "cpu": "200m",
                "memory": "256Mi"
            },
            "limits": {
                "cpu": "500m",
                "memory": "512Mi"
            }
        },
        "redis": {
            "requests": {
                "cpu": "100m",
                "memory": "128Mi"
            },
            "limits": {
                "cpu": "300m",
                "memory": "256Mi"
            }
        }
    }
}